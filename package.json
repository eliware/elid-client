{
  "name": "@eliware/elid-client",
  "version": "15.0.1",
  "type": "module",
  "description": "Node.js OAuth 2.1 client library for EliD issuer discovery, PKCE authentication, token retrieval, and session management.",
  "keywords": [
    "eliware",
    "oauth2",
    "oauth2.1",
    "openid-connect",
    "authentication",
    "authorization",
    "pkce",
    "issuer",
    "identity",
    "nodejs",
    "esm"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/index.mjs",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "examples/",
    "specs/",
    "package.json"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "typecheck": "tsc --project tsconfig.json",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eliware/test": "^15.0.1",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/elid-client.git"
  },
  "homepage": "https://github.com/eliware/elid-client#readme",
  "bugs": {
    "url": "https://github.com/eliware/elid-client/issues"
  },
  "eliware": {
    "id": "E-1331",
    "apply": [
      "general",
      "library",
      "npm-published"
    ]
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  }
}
